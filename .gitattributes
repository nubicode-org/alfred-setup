# Shell scripts must keep Unix line endings, even when the kit is cloned on Windows:
# a carriage return makes bash fail with "bad interpreter" or "$'\r': command not found".
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.ps1 text eol=crlf
*.psd1 text eol=crlf
